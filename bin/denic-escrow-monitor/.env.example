# Copy to .env and chmod 600 .env. Never commit real secrets.
DENIC_ESCROW_JWT=
DENIC_ESCROW_ENV=production
DENIC_IANA_ID=
DENIC_OPERATOR_UUID=

# ICANN RRI is optional. Leave credentials blank to disable it.
# HTTP Basic auth (not JWT). Configure credentials and allowed IPs in ICANN NSP.
ICANN_RRI_USERNAME=
ICANN_RRI_PASSWORD=
# ICANN publicly lists this for registrar DEAs; confirm your registrar's assigned URL.
# For OT&E use the exact endpoint ICANN gives you (do not point test credentials at production).
ICANN_RRI_BASE_URL=https://rr-api.icann.org
